POSTGRES_DB=transitdues
POSTGRES_USER=transitdues_user
POSTGRES_PASSWORD=change_me
MONGO_USERNAME=transitdues_mongo
MONGO_PASSWORD=change_me
REDIS_PASSWORD=change_me
RABBITMQ_USERNAME=transitdues_rabbit
RABBITMQ_PASSWORD=change_me
OAUTH_ADMIN_EMAILS=admin@example.com
OAUTH_FINANCE_EMAILS=finance@example.com

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
SEED_FINANCE_EMAIL=finance@example.com
SEED_FINANCE_PASSWORD=change_me

# Google OAuth2 client (create one in Google Cloud Console; optional, only needed
# to test Google login - the app still runs without these set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local dev email (Mailpit, started by docker-compose.yml - no real values needed).
# View sent mail at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@transitdues.local

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5