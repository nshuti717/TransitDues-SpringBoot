POSTGRES_DB=transitdues
POSTGRES_USER=transitdues_user
POSTGRES_PASSWORD=change_me
MONGO_USERNAME=transitdues_mongo
MONGO_PASSWORD=change_me
REDIS_PASSWORD=change_me
RABBITMQ_USERNAME=transitdues_rabbit
RABBITMQ_PASSWORD=change_me
OAUTH_ADMIN_EMAILS=admin@example.com
OAUTH_FINANCE_EMAILS=finance@example.com

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
SEED_FINANCE_EMAIL=finance@example.com
SEED_FINANCE_PASSWORD=change_me

# Google OAuth2 client (create one in Google Cloud Console; optional, only needed
# to test Google login - the app still runs without these set, and the "Continue
# with Google" button hides itself on /login when they're blank).
# Full setup steps: docs/DOCUMENTATION.md, "Google OAuth2 setup".
# NEVER commit real values here - this file only ever holds placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only in documentation/scripts for printing the right redirect URI below -
# the application itself does not read this (Spring Security derives the OAuth2
# redirect URI from each request automatically, so this has no code dependency).
# Local:      http://localhost:8080
# Production: https://your-deployed-domain.example.com
APP_BASE_URL=http://localhost:8080

# --- Email: two modes, same variables ---
# A) Local dev (default below): Mailpit, started by docker-compose.yml, no real
#    values needed. View sent mail at http://localhost:8025.
# B) Production: real SMTP so OTP emails land in a real inbox. See
#    docs/DOCUMENTATION.md, "Production email (Gmail SMTP)" for the exact Gmail
#    App Password steps. Example production values (commented out):
#      MAIL_HOST=smtp.gmail.com
#      MAIL_PORT=587
#      MAIL_USERNAME=your-address@gmail.com
#      MAIL_PASSWORD=your-16-character-app-password
#      MAIL_SMTP_AUTH=true
#      MAIL_SMTP_STARTTLS=true
#      MAIL_FROM=your-address@gmail.com
# NEVER commit a real Gmail password or App Password here - placeholders only.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@transitdues.local

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60